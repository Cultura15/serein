{{ 'section-header.css' | asset_url | stylesheet_tag }}

<header class="header header--top-left {% if request.page_type == 'index' %}header--overlay{% else %}header--solid{% endif %}" style="--icon-scale: 1.1;">
  <input type="checkbox" id="header-menu-toggle" class="header__toggle" hidden>

  <div class="header__container">

    <div class="header__top-row">
      <!-- Logo -->
      <h1 class="header__heading">
        <a href="{{ routes.root_url }}" class="header__heading-link">
          <span class="header__heading-name">{{ section.settings.logo_text | default: 'SEREIN' }}</span>
        </a>
      </h1>

      <!-- Icons -->
      <div class="header__icons">
        <div class="header__search-wrap" id="header-search-wrap" data-open="false">
          <button type="button" class="header__icon header__icon--search link" id="header-search-toggle" aria-label="Search" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="10.8" cy="10.8" r="6.8"/>
              <path d="m16 16 5 5"/>
            </svg>
            <span class="header__icon-label">Search</span>
          </button>

          <div class="header__search-inline" id="header-search-panel" role="search">
            <input
              type="text"
              class="header__search-input"
              id="header-search-input"
              placeholder="Search…"
              autocomplete="off"
              aria-label="Search products"
            >
            <button type="button" class="header__search-close" id="header-search-close" aria-label="Close search">
              <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>

            <div class="header__search-results" id="header-search-results" hidden></div>
          </div>
        </div>

        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link" id="cart-icon-bubble" aria-label="Cart" role="button" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M3 4h2l2.2 11h11.5L21 8H6"/>
            <circle cx="9" cy="19" r="1.3"/>
            <circle cx="18" cy="19" r="1.3"/>
          </svg>
          <span class="header__icon-bubble">{{ cart.item_count }}</span>
          <span class="visually-hidden">Cart</span>
        </a>

        <label for="header-menu-toggle" class="header__hamburger" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </label>
      </div>
    </div>

    <!-- Inline menu, sits under the logo -->
    <nav class="header__inline-menu">
      <ul class="list-menu list-menu--inline" role="list">
        <li class="list-menu__item">
          <a href="{{ routes.all_products_collection_url }}" class="header__menu-item link"><span>Shop</span></a>
        </li>
        <li class="list-menu__item">
          <a href="{{ pages.about.url }}" class="header__menu-item link"><span>About</span></a>
        </li>
      </ul>
    </nav>
  </div>

  <!-- Mobile drawer -->
  <div class="header__mobile-menu">
    <ul class="list-menu" role="list">
      <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
      <li><a href="/page/about">About</a></li>
    </ul>
  </div>
</header>

<script src="{{ 'section-header.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo text",
      "default": "SEREIN"
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}