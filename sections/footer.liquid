{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer id="contact" class="site-footer">

  <div class="footer-container footer-main">

    {%- comment -%}
      LEFT — Brand
    {%- endcomment -%}

    <div class="footer-brand">
      <div class="footer-wordmark">
        {{ section.settings.brand_name | default: 'SEREIN' }}<span class="footer-wordmark-accent">.</span>COM
      </div>
    </div>


    {%- comment -%}
      RIGHT — Footer information
    {%- endcomment -%}

    <div class="footer-info">

      {%- comment -%}
        Contact
      {%- endcomment -%}

      <div class="footer-col footer-col--contact">

        {%- if section.settings.address != blank
          or section.settings.email != blank
          or section.settings.phone != blank -%}

          <h3 class="footer-heading">
            Contact
          </h3>

          <ul class="footer-contact-list">

            {%- if section.settings.address != blank -%}
              <li>
                {{ section.settings.address }}
              </li>
            {%- endif -%}

            {%- if section.settings.email != blank -%}
              <li>
                <a href="mailto:{{ section.settings.email }}">
                  {{ section.settings.email }}
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.phone != blank -%}
              <li>
                <a href="tel:{{ section.settings.phone | replace: ' ', '' }}">
                  {{ section.settings.phone }}
                </a>
              </li>
            {%- endif -%}

          </ul>

        {%- endif -%}

      </div>


      {%- comment -%}
        Shop + Social
      {%- endcomment -%}

      <div class="footer-col footer-col--links">

        {%- if section.settings.menu != blank -%}

          <h3 class="footer-heading">
            Shop
          </h3>

          <ul class="footer-link-list">

            {%- for link in section.settings.menu.links -%}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}

          </ul>

        {%- endif -%}


        {%- if section.settings.social_instagram != blank
          or section.settings.social_facebook != blank
          or section.settings.social_tiktok != blank
          or section.settings.social_pinterest != blank -%}

          <h3 class="footer-heading footer-heading--social">
            Follow
          </h3>

          <ul class="footer-social-list">

            {%- if section.settings.social_instagram != blank -%}
              <li>
                <a
                  href="{{ section.settings.social_instagram }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Instagram
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.social_facebook != blank -%}
              <li>
                <a
                  href="{{ section.settings.social_facebook }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Facebook
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.social_tiktok != blank -%}
              <li>
                <a
                  href="{{ section.settings.social_tiktok }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  TikTok
                </a>
              </li>
            {%- endif -%}

            {%- if section.settings.social_pinterest != blank -%}
              <li>
                <a
                  href="{{ section.settings.social_pinterest }}"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Pinterest
                </a>
              </li>
            {%- endif -%}

          </ul>

        {%- endif -%}

      </div>

    </div>

  </div>


  {%- comment -%}
    Bottom — Legal
  {%- endcomment -%}

  <div class="footer-container footer-bottom">

    <div class="footer-legal">

      <span class="footer-copyright">
        © {{ 'now' | date: '%Y' }}
        {{ section.settings.brand_name | default: shop.name }}.
        All rights reserved.
      </span>

   

    </div>

  </div>

</footer>


{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand name",
      "default": "SEREIN"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Contact phone"
    },
    {
      "type": "header",
      "content": "Shop"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Quick links menu"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest URL"
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
