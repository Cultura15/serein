{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}

<section class="fish-featured">
  <div class="fish-featured__grid">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="fish-featured__card" {{ block.shopify_attributes }}>
        <div class="fish-featured__image-wrap">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              alt="{{ block.settings.image.alt | default: block.settings.title }}"
              loading="lazy"
              class="fish-featured__image"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            <div class="fish-featured__image fish-featured__image--placeholder">
              {{ 'image' | placeholder_svg_tag: 'fish-featured__placeholder-svg' }}
            </div>
          {% endif %}

          <span class="fish-featured__overlay" aria-hidden="true"></span>

          <span class="fish-featured__arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M13 6l6 6-6 6"/>
            </svg>
          </span>

          <h3 class="fish-featured__title">{{ block.settings.title }}</h3>
        </div>
      </a>
    {% endfor %}
  </div>

</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Products"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Product Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}