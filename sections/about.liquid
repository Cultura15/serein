{{ 'about.css' | asset_url | stylesheet_tag }}

<section class="fish-about">
  <div class="fish-about__container">

    <div class="fish-about__image-wrap">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 900 }}"
          alt="{{ section.settings.image.alt | default: section.settings.heading }}"
          loading="lazy"
          class="fish-about__image"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
        >
      {% else %}
        <div class="fish-about__image fish-about__image--placeholder">
          {{ 'image' | placeholder_svg_tag: 'fish-about__placeholder-svg' }}
        </div>
      {% endif %}
    </div>

    <div class="fish-about__content">
      {% if section.settings.overline != blank %}
        <p class="fish-about__overline">{{ section.settings.overline }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="fish-about__heading">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="fish-about__text">{{ section.settings.text }}</div>
      {% endif %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About us"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We aim to share the mentality of owning only beautiful and useful objects born from the unapologetic love for creativity and thirst for design.</p>"
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}