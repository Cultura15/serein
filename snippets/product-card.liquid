{% comment %} <a href="{{ product.url }}" class="product-card">

  {% if product.featured_image %}
    {{
      product.featured_image
      | image_url: width: 600
      | image_tag: loading: 'lazy'
    }}
  {% endif %}

  <div class="product-card-info">
    <h3>{{ product.title }}</h3>

    <p>
      {{ product.price | money }}
    </p>
  </div>

</a> {% endcomment %}
